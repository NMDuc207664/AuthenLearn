@using AuthenLearn.Data.Common
@typeparam TEntity

<div class="w-100">
    <!-- Title Section with Bootstrap Styling -->
    <div class="mb-4 d-flex justify-content-center">
        <div class="bg-light p-3 bg-gradient rounded-4 shadow-lg px-4 py-3 text-center position-relative thick-border">

            <!-- Title Text -->
            <h3 class="mb-0 fw-bold text-danger">
                @Title
            </h3>

            <!-- Simulated shimmer (optional, basic version) -->
            <div class="position-absolute top-0 start-0 w-100 h-100" style="
                background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.2) 50%, transparent 100%);
                animation: shimmer 2s infinite;
                z-index: 1;
                pointer-events: none;
            "></div>
        </div>
    </div>
</div>

<style>
    .shimmer-overlay {
        background: linear-gradient(120deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
        animation: shimmer 2s infinite linear;
        z-index: 1;
        pointer-events: none;
    }
</style>
<style>
    .thick-border {
        border: 4px solid #29198776 !important;
        /* #198754 là màu success của Bootstrap */
    }
</style>
@if (PagedResult is null || PagedResult.Items is null)
{
    <p class="text-gray-500">Đang tải dữ liệu...</p>
}
else if (!PagedResult.Items.Any())
{
    <p class="text-gray-500">Không có dữ liệu để hiển thị.</p>
}
else
{
    <div class="" style="height: 500px; overflow-y: auto;">
        <table class="min-w-full table-fixed border-collapse border border-gray-300 table table-hover">
            <thead class="bg-gray-100 sticky top-0">
                <tr>
                    @foreach (var header in RowHeaders)
                    {
                        <th class="border px-4 py-2 bg-gray-100">@header</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in PagedResult.Items)
                {
                    <tr class="hover:bg-gray-50">
                        @RowTemplate(item)
                    </tr>
                }
                @* @if (PagedResult.Items.Count() < PageSize)
                    {
                        @for (int i = PagedResult.Items.Count(); i < PageSize; i++)
                        {
                            <tr style="height: 50px;">
                                @foreach (var header in RowHeaders)
                                {
                                    <td class="border px-4 py-2">&nbsp;</td>
                                }
                            </tr>
                        }
                    } *@
            </tbody>
        </table>
    </div>
}


