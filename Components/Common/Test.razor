@* Component Test.razor *@
@typeparam TEntity
@if (Show)
{
    <div class="modal-overlay"
        style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000; display: flex; justify-content: center; align-items: center;">
        <div class="card" style="width: 24rem; max-width: 90%; margin: auto;">
            <div class="card-body">
                <h5 class="card-title">Xác nhận xóa</h5>
                <p class="card-text">Bạn có chắc chắn muốn xóa chi tiêu này không?</p>
                @if (FormBody != null)
                {
                    @FormBody(Entity)
                }
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">
                        Hủy
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="Confirm">
                        Xóa
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Model.Expense expenseToDelete = new();
    [Parameter]
    public bool Show { get; set; }
    [Parameter]
    public TEntity Entity { get; set; } = default;

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }
    [Parameter] public RenderFragment<TEntity>? FormBody { get; set; }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync();
    }
}