@using AuthenLearn.Applications.Interfaces.ServicesInterfaces
@using AuthenLearn.Model
@using AuthenLearn.Model.Enum
@using Microsoft.AspNetCore.Components.Forms
@inject IDebtService iDebtService
@rendermode InteractiveServer

@if (Type == ExpenseType.Debt)
{
    <div class="mb-3">
        <label class="form-label">Chủ nợ</label>
        <InputText class="form-control" @bind-Value="Debt_1.Owner" />
    </div>
    <div class="mb-3">
        <label class="form-label">Số tiền nợ</label>
        <InputNumber class="form-control" @bind-Value="Debt_1.TotalAmountOfDebt" />
    </div>
    <div class="mb-3">
        <label class="form-label">Mô tả</label>
        <InputText class="form-control" @bind-Value="Debt_1.Description" />
    </div>
}
else if (Type == ExpenseType.PayOffDebt)
{
    <div class="mb-3">
        <label class="form-label">Chọn khoản nợ để trả</label>
        <select class="form-select" @bind="SelectedDebtId">
            <option value="">-- Chọn khoản nợ --</option>
            @if (ListDebts != null && ListDebts.Any())
            {
                @foreach (var debt in ListDebts)
                {
                    <option value="@debt.Id">@debt.Owner - @debt.Description - @debt.TotalAmountOfDebt.ToString("N0") đ</option>
                }
            }
            else
            {
                <option disabled>Không có khoản nợ nào để trả</option>
            }
        </select>
    </div>
}

@code {
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public ExpenseType Type { get; set; }
    [Parameter] public Model.Debt Debt_1 { get; set; } = new();
    [Parameter] public Guid? SelectedDebtId { get; set; }
    [Parameter] public EventCallback<Guid> SelectedDebtIdChanged { get; set; }
    [Parameter] public List<Model.Debt>? ListDebts { get; set; } = new();

    public Guid AddDebtFE()
    {
        return iDebtService.AddDebt(Debt_1, UserId);
    }

    public async Task UpdateDebtFE()
    {
        await iDebtService.UpdateDebt(Debt_1);
    }

    public void UpdateListDebts(List<Model.Debt> debts)
    {
        ListDebts = debts;
        Console.WriteLine($"UpdateListDebts called with {debts?.Count ?? 0} debts");
        StateHasChanged();
    }

    public async Task UpdateDebtPaidFE(Guid debtId)
    {
        await iDebtService.UpdateDebtPaid(debtId);
    }

    public Guid? GetSelectedDebtId()
    {
        Console.WriteLine($"GetSelectedDebtId returning: {SelectedDebtId}");
        return SelectedDebtId;
    }
    public async Task DeleteDebtFE(Guid debtId)
    {
        await iDebtService.DeleteDebt(debtId);
    }
}
